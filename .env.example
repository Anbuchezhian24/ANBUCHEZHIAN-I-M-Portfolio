# ===================================================
# Resend Email Configuration for Portfolio Contact Form
# ===================================================

# Your Resend API Key from https://resend.com/api-keys
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_your_resend_api_key_here

# The email address that will receive visitor contact messages
CONTACT_EMAIL=your_email@example.com

# The verified sender email address configured in your Resend account
# If using Resend test domain: Portfolio <onboarding@resend.dev>
# If using a custom verified domain: Portfolio <contact@yourdomain.com>
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Optional: Production site URL (used for metadata, robots.txt, sitemap)
NEXT_PUBLIC_SITE_URL=https://anbuchezhian.dev
